# NeuroVision AI — Environment Configuration
# Copy this to .env and fill in your values

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production-neurovision-ai-secret

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neurovision
DB_USER=neurovision
DB_PASSWORD=neurovision_secret
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ─── AI Settings ──────────────────────────────────────────────────────────────
AI_DEVICE=cuda               # 'cuda' or 'cpu'
AI_HALF_PRECISION=true       # FP16 inference (GPU only)
AI_BATCH_SIZE=4
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.45
MODELS_DIR=./models
YOLO_MODEL=yolov8n.pt
POSE_MODEL=yolov8n-pose.pt

# Tracking
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3
TRACK_IOU_THRESHOLD=0.3

# Trajectory
TRAJ_HISTORY=30
TRAJ_PREDICT=15

# Anomaly
ANOMALY_THRESHOLD=0.75

# Acceleration
USE_TENSORRT=false
USE_ONNX=false

# ─── Streaming ────────────────────────────────────────────────────────────────
MAX_CAMERAS=16
FRAME_WIDTH=1280
FRAME_HEIGHT=720
TARGET_FPS=25
JPEG_QUALITY=85
STREAM_BUFFER_SIZE=10
RECONNECT_DELAY=2.0
MAX_RECONNECT=5

# ─── Alerts ───────────────────────────────────────────────────────────────────
ZONE_COOLDOWN=30             # Seconds between same-type alerts per camera
CROWD_THRESHOLD=0.7          # Crowd density alert threshold (0-1)
MAX_PERSONS=50               # Max persons before congestion alert
LOITER_TIME=60               # Seconds before loitering alert
ABANDONED_TIME=30            # Seconds before abandoned object alert
ALERT_WEBHOOK_URL=           # Optional: POST alerts here
WEBHOOK_TIMEOUT=5.0

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
RECORDINGS_DIR=./data/recordings
REPORTS_DIR=./data/reports

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
